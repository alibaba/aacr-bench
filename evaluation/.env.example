# 复制为 .env 后填入真实值：cp .env.example .env
# 运行评审前手动加载：set -a && source .env && set +a
# 评测阶段（Judge）会自动读取本文件，无需 source。

# OCR（open-code-review 评审器）
## Base URL
export OCR_LLM_URL="https://your-llm-endpoint/compatible-mode/v1"

## API key / auth token.
export OCR_LLM_TOKEN="your-ocr-token"

## Model name.
export OCR_LLM_MODEL="your-model-name"

## true  = use Anthropic protocol
## false = use OpenAI protocol
export OCR_USE_ANTHROPIC="false"

# Claude Code 评审器
## Base URL
export ANTHROPIC_BASE_URL="https://your-anthropic-endpoint/apps/anthropic"

## API key / auth token.
export ANTHROPIC_AUTH_TOKEN="your-anthropic-token"

## Model name.
export ANTHROPIC_MODEL="your-model-name"

# Codex 评审器
export CODEX_API_KEY="your-codex-api-key"

## 自建网关 / 代理 base_url（可选）
## 设置后框架自动生成 model_provider = "gateway" + [model_providers."gateway"] 段
## 让 codex 连接自定义端点（如 MaaS / cc_switch 转发）而非直连 api.openai.com
## 不填则用 codex 默认 provider（直连 api.openai.com）
export CODEX_GATEWAY_URL="https://your-llm-endpoint/compatible-mode/v1"

## 模型名（可选），不填则用 codex 默认模型
export CODEX_MODEL="gpt-5-codex"

# Judge (LLM as a Judge，评测阶段语义匹配专用，与 OCR/Claude 解耦)
## Base URL（OpenAI 兼容接口）
export JUDGE_BASE_URL="https://your-llm-endpoint/compatible-mode/v1"

## API key / auth token.（留空则语义匹配自动退化为本地 Mock 模式）
export JUDGE_API_KEY="your-judge-token"

## Model name.
export JUDGE_MODEL="your-model-name"

## true = 强制使用本地 Mock 相似度（即使配置了 JUDGE_API_KEY）
export JUDGE_USE_MOCK="false"
