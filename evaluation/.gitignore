# 虚拟环境
.venv/

# 密钥配置（含 token，切勿提交）
.env

# benchmark 原始数据：体积大，按同名 .meta.json 描述从远端拉取（见 converter），不提交
benchmark/**/*.json
!benchmark/**/*.meta.json
# 下载中断可能残留的临时 .part 文件（见 _stream_to_file），勿提交
benchmark/**/*.part

# 仓库 clone 缓存（体积大，自动生成）
repo/

# 转换后的标准数据集（由转换器生成）
data/*.jsonl

# codex 对话历史存档
codex_home/

# 评审结果与评测指标（运行产物）
results/
metrics/

# Python 缓存
__pycache__/
*.pyc
